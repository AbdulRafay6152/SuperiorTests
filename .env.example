# ============================================================
# SuperiorTests — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
# DO NOT commit .env to version control.

# ── Database ────────────────────────────────────────────────
DATABASE_URL=postgresql://superiortests:superiortests_dev@localhost:5432/superiortests

# ── Server ──────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173

# ── Authentication ──────────────────────────────────────────
# Generate a strong random string for production:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=dev-secret-change-in-production

# ── Email (SMTP) ────────────────────────────────────────────
# Leave blank to disable email (events logged to console).
# For Gmail: use an App Password (not your account password).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=SuperiorTests <noreply@superiortests.com>
