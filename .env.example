# ============================================================
# SuperiorTests — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.

# ── Server ─────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ── Database (PostgreSQL) ──────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/superiortests

# ── JWT Authentication ─────────────────────────────────────
# Generate with: openssl rand -base64 32
JWT_SECRET=change-this-in-production-to-a-random-string
JWT_REFRESH_SECRET=change-this-refresh-secret-to-another-random-string
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── SMTP Email (Nodemailer) ────────────────────────────────
# Leave SMTP_USER empty to disable email (logs to console instead)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=SuperiorTests <noreply@superiortests.com>

# ── App URL (frontend) ─────────────────────────────────────
APP_URL=http://localhost:5173

# ── Security ───────────────────────────────────────────────
BCRYPT_ROUNDS=12
